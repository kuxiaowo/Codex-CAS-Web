# Conda 与 systemd 用户服务
CONDA_ENV_NAME=Codex-CAS-Web
PYTHON_VERSION=3.12
SYSTEMD_SERVICE_NAME=codex-cas-web

# 一体化 Web 服务
APP_HOST=127.0.0.1
APP_PORT=3300
APP_RELOAD=false

# SQLite
DATABASE_PATH=data/cas_notes.db
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_BUSY_TIMEOUT_MS=5000

# 图片资源
UPLOAD_MAX_MB=50
THUMBNAIL_MAX_WIDTH=640
THUMBNAIL_MAX_HEIGHT=640
THUMBNAIL_WEBP_QUALITY=82
THUMBNAIL_WEBP_METHOD=6
THUMBNAIL_SYNC_MINUTES=5

# NetHub Accounts OIDC
# 生产环境必须使用 HTTPS 回调地址，并通过 NetHub-Accounts CLI 注册为精确回调地址。
OIDC_ISSUER=https://auth.nethub.wiki
OIDC_CLIENT_ID=cas
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://cas.nethub.wiki/api/auth/callback
OIDC_COOKIE_SECURE=true
OIDC_STATE_EXPIRE_SECONDS=600
LOCAL_SESSION_EXPIRE_SECONDS=604800
# 以英文逗号分隔的中央 sub；仅这些明确配置的用户会在首次进入时成为本站管理员。
CAS_ADMIN_SUBS=
