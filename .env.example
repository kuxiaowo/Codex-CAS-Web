# Conda 与 systemd 用户服务
CONDA_ENV_NAME=Codex-CAS-Web
PYTHON_VERSION=3.12
SYSTEMD_SERVICE_NAME=codex-cas-web

# 一体化 Web 服务
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=3300
APP_RELOAD=false

# 数据库：production 默认使用 D1；development/test 默认使用 SQLite。
DATABASE_BACKEND=
DATABASE_PATH=data/cas_notes.db
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_BUSY_TIMEOUT_MS=5000
# 私有 D1 网关（生产必填，至少 32 字节密钥）
D1_GATEWAY_URL=https://codex-db-gateway.example.com
D1_HMAC_SECRET=
D1_REQUEST_TIMEOUT_SECONDS=10

# 图片资源
UPLOAD_MAX_MB=50
THUMBNAIL_MAX_WIDTH=640
THUMBNAIL_MAX_HEIGHT=640
THUMBNAIL_WEBP_QUALITY=82
THUMBNAIL_WEBP_METHOD=6

# 生产环境固定使用私有 R2；仅 development/test 可显式改为 local。
MEDIA_STORAGE_BACKEND=r2
MEDIA_GATEWAY_URL=https://codex-media.nethub.wiki
# 与 nethub-codex-media-gateway 的 HMAC_SECRET 相同，至少 32 个 UTF-8 字节。
MEDIA_HMAC_SECRET=
MEDIA_REQUEST_TIMEOUT_SECONDS=30
MEDIA_DOWNLOAD_TTL_SECONDS=90
MEDIA_MULTIPART_THRESHOLD_MB=20
MEDIA_MULTIPART_PART_MB=8

# NetHub Accounts OIDC
# 生产环境必须使用 HTTPS 回调地址，并通过 NetHub-Accounts CLI 注册为精确回调地址。
OIDC_ISSUER=https://auth.nethub.wiki
OIDC_CLIENT_ID=cas
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://codex.nethub.wiki/api/auth/callback
OIDC_COOKIE_SECURE=true
OIDC_STATE_EXPIRE_SECONDS=600
LOCAL_SESSION_EXPIRE_SECONDS=604800
# 以英文逗号分隔的中央 sub；仅这些明确配置的用户会在首次进入时成为本站管理员。
CAS_ADMIN_SUBS=
